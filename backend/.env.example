# Copy this file to .env and fill in real values. Never commit .env.

# ── Runtime ───────────────────────────────────────────────────────────────
ENV=local                          # local | dev | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ── Gemini (required) ────────────────────────────────────────────────────
GEMINI_API_KEY=                    # API key for Gemini 3.5 (Google AI Studio or Vertex AI).
GEMINI_MODEL=gemini-3.5-flash      # Gemini model id used by every agent's LLM calls. Change here, never per-agent.

# ── Google Cloud (required) ──────────────────────────────────────────────
GCP_PROJECT_ID=                    # GCP project backing Firestore, Calendar, and Gmail.
FIRESTORE_COLLECTION_PREFIX=taskmaster   # Prefix applied to every Firestore collection name (e.g. "<prefix>_tickets").

# ── Vertical config (required) ───────────────────────────────────────────
ACTIVE_VERTICAL=it_support         # Name of the vertical config pack to load from app/verticals/packs/ (no file extension).

# ── Gmail channel (email ingestion + sending) ────────────────────────────
GMAIL_CLIENT_ID=                   # OAuth 2.0 client ID for the Gmail API.
GMAIL_CLIENT_SECRET=               # OAuth 2.0 client secret for the Gmail API.
GMAIL_REFRESH_TOKEN=               # Long-lived OAuth refresh token for the mailbox Taskmaster reads from and sends as.
GMAIL_SENDER_EMAIL=                # Mailbox address Taskmaster sends replies from.

# ── Twilio channel (SMS + voice) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=                # Twilio account SID.
TWILIO_AUTH_TOKEN=                 # Twilio auth token.
TWILIO_FROM_NUMBER=                # Twilio phone number Taskmaster sends SMS/voice from, E.164 format (e.g. +15551234567).

# ── Scheduler ─────────────────────────────────────────────────────────────
CALENDAR_ID=                       # Google Calendar ID the Scheduler Agent checks and books appointments into.

# ── Safety switch ─────────────────────────────────────────────────────────
AUTO_SEND_REPLIES=false            # true = Reply Agent sends replies automatically. false = drafts only (safe default for demos).
