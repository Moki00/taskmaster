# Copy this file to .env and fill in real values. Never commit .env.
#
# IMPORTANT: keep comments on their OWN lines (like this), never inline after a
# value (e.g. `KEY=value  # note`). python-dotenv treats the trailing text as part
# of the value, so an empty `KEY=  # note` becomes the literal string "# note"
# instead of empty — which silently defeats the "fail loud when unset" checks.

# ── Runtime ───────────────────────────────────────────────────────────────
# local | dev | staging | production. ENV=local runs with the in-memory repo and
# needs zero GCP credentials.
ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Gemini (required to actually run the pipeline) ───────────────────────────
# API key for Gemini 3.5 (Google AI Studio or Vertex AI). Required for live runs;
# tests mock Gemini and don't need it.
GEMINI_API_KEY=
# Gemini model id used by every agent's LLM calls. Change here, never per-agent.
GEMINI_MODEL=gemini-3.5-flash

# ── Google Cloud ─────────────────────────────────────────────────────────────
# GCP project backing Firestore, Calendar, and Gmail. Only used when ENV != local.
GCP_PROJECT_ID=hackathon8-20
# Region for Vertex AI / Gemini calls.
GCP_REGION=global
# Prefix applied to every Firestore collection name (e.g. "<prefix>_tickets").
FIRESTORE_COLLECTION_PREFIX=taskmaster

# ── Vertical config (required) ───────────────────────────────────────────────
# Name of the vertical config pack to load from app/verticals/packs/ (no extension).
ACTIVE_VERTICAL=it_support

# ── Gmail channel (email ingestion + sending) ────────────────────────────────
# Leave blank until you wire up Gmail. Blank = channel disabled, clients fail loud
# if constructed.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# ── Twilio channel (SMS + voice) ─────────────────────────────────────────────
# Leave blank until you wire up Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Google Calendar ID the Scheduler Agent checks and books into. Blank = scheduling
# degrades gracefully (proposes nothing, never crashes the pipeline).
CALENDAR_ID=

# ── Safety switch ─────────────────────────────────────────────────────────────
# true = Reply Agent sends replies automatically. false = drafts only (safe for demos).
AUTO_SEND_REPLIES=false
